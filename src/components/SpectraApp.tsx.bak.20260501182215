function BootScreen({ progress, done }: { progress: number; done: boolean }) {
  const chromaShift = Math.round((1 - progress / 100) * 9);
  const hexProg = Math.round(progress * 2.55).toString(16).toUpperCase().padStart(2, "0");
  const status = progress < 22 ? "SYS.INIT" : progress < 52 ? "SHADER.COMPILE" : progress < 84 ? "GL.PIPELINE" : "VISION.READY";
  return (
    <div
      className="fixed inset-0 z-50 flex flex-col items-center justify-center"
      style={{
        background: "radial-gradient(circle at 50% 85%, #B014F0 0%, #650A96 28%, #230035 58%, #050008 100%)",
        opacity: done ? 0 : 1,
        pointerEvents: done ? "none" : "all",
        transition: "opacity 0.9s ease",
      }}
    >
      <style>{`
        @keyframes bootScan { 0%{top:-2px} 100%{top:100%} }
        @keyframes bootBlink { 0%,80%,100%{opacity:.18} 90%{opacity:.6} }
        @keyframes bootPulse { 0%,100%{opacity:.35} 50%{opacity:.85} }
        @keyframes bootFadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
      `}</style>

      {/* Sweeping scan line */}
      <div style={{
        position:"absolute", left:0, right:0, height:1, pointerEvents:"none",
        background:"linear-gradient(90deg,transparent 0%,rgba(211,75,255,.5) 25%,rgba(211,75,255,.5) 75%,transparent 100%)",
        animation:"bootScan 2.6s linear infinite",
      }}/>

      {/* Scanlines texture */}
      <div style={{
        position:"absolute", inset:0, pointerEvents:"none",
        backgroundImage:"repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(176,20,240,.02) 3px,rgba(176,20,240,.02) 4px)",
      }}/>

      {/* Corner TL */}
      <div style={{position:"absolute",top:20,left:20,fontFamily:"'Courier New',monospace",fontSize:9,letterSpacing:"2px",color:"rgba(231,174,255,.35)",lineHeight:1.9,animation:"bootBlink 3.5s ease infinite"}}>
        SPECTRA OS v2.1<br/>GL_ES 1.0 · WEBGL<br/>PROC: REALTIME
      </div>
      {/* Corner TR */}
      <div style={{position:"absolute",top:20,right:20,fontFamily:"'Courier New',monospace",fontSize:9,letterSpacing:"2px",color:"rgba(231,174,255,.35)",lineHeight:1.9,textAlign:"right",animation:"bootBlink 3.5s ease infinite 1.4s"}}>
        PIPELINE: ACTIVE<br/>FX: MULTI-LAYER<br/>AUDIO: REACTIVE
      </div>
      {/* Corner BL */}
      <div style={{position:"absolute",bottom:20,left:20,fontFamily:"'Courier New',monospace",fontSize:9,letterSpacing:"2px",color:"rgba(231,174,255,.24)"}}>
        0xFF·0x{hexProg} · BOOT/{progress.toString().padStart(3,"0")}
      </div>
      {/* Corner BR */}
      <div style={{position:"absolute",bottom:20,right:20,fontFamily:"'Courier New',monospace",fontSize:9,letterSpacing:"2px",color:"rgba(231,174,255,.24)",textAlign:"right"}}>
        {new Date().getFullYear()} LOVEBEING
      </div>

      {/* Logo — chroma shift converges to 0 as load completes */}
      <div style={{marginBottom:30, animation:"bootFadeIn .8s ease both"}}>
        <SpectraLogo size={118} chromaShift={chromaShift}/>
      </div>

      {/* Tagline */}
      <div style={{
        fontFamily:"'Courier New',monospace", fontSize:10, letterSpacing:"5px",
        color:"rgba(231,174,255,.58)", marginBottom:44, textTransform:"uppercase",
        animation:"bootFadeIn .8s ease .2s both",
      }}>
        computational vision engine
      </div>

      {/* Progress track */}
      <div style={{width:230, position:"relative", marginBottom:16, animation:"bootFadeIn .8s ease .35s both"}}>
        <div style={{height:1, background:"rgba(255,255,255,.07)"}}>
          <div style={{
            height:"100%", width:`${progress}%`,
            background:"linear-gradient(90deg,rgba(176,20,240,.45),#D34BFF)",
            transition:"width .12s linear",
          }}/>
        </div>
        {/* Glowing cursor head */}
        <div style={{
          position:"absolute", top:-3, height:7, width:3, background:"#D34BFF",
          left:`${Math.min(98.5, progress)}%`, transform:"translateX(-50%)",
          boxShadow:"0 0 12px 4px rgba(211,75,255,.85)", transition:"left .12s linear",
        }}/>
      </div>

      {/* Status label */}
      <div style={{
        fontFamily:"'Courier New',monospace", fontSize:10, letterSpacing:"4px",
        color:"rgba(231,174,255,.64)", animation:"bootPulse 1.5s ease infinite",
      }}>
        {status}
      </div>
    </div>
  );
}



