              <button
                onClick={() => setDrawActive(!drawActive)}
                style={{ ...modeBtnStyle, fontSize: 10, letterSpacing: "1px", ...(drawActive ? modeBtnActive : {}) }}>
                ✏ DRAW {drawActive ? "ON" : "OFF"}
              </button>
              {drawActive && <>
                <input type="color" value={brushColor} onChange={e => setBrushColor(e.target.value)}
                  style={{ width: 32, height: 32, border: "1px solid #2a2a44", borderRadius: 6, background: "none", cursor: "pointer" }}/>
                <button onClick={() => setStrokes(prev => prev.slice(0,-1))} style={modeBtnStyle} title="Undo">↩</button>
                <button onClick={() => { setStrokes([]); const dc=drawCanvasRef.current; if(dc){const c=dc.getContext("2d");c?.clearRect(0,0,dc.width,dc.height);} }} style={modeBtnStyle} title="Clear">✕</button>
              </>}
            </div>
            {drawActive && <SliderRow label="SIZE" value={brushSize} min={2} max={40} step={1} onChange={setBrushSize}/>}
            {drawActive && <SliderRow label="OPACITY" value={brushOpacity} min={0.1} max={1} step={0.05} onChange={setBrushOpacity}/>}



            {/* ── CHAOS */}
            <SectionLabel>⚡ CHAOS</SectionLabel>
            <div style={{ display: "flex", gap: 6, alignItems: "center", marginBottom: 6 }}>
              <button
                onClick={() => setChaosMode(!chaosMode)}
                style={{ ...modeBtnStyle, fontSize: 10, letterSpacing: "1px", flex: 1,
                  ...(chaosMode ? { ...modeBtnActive, borderColor: "#ff4466", color: "#ff4466", boxShadow: "0 0 14px rgba(255,68,102,0.35)", textShadow: "0 0 8px rgba(255,68,102,0.6)" } : {}) }}
              >{chaosMode ? "⚡ CHAOS ON" : "⚡ CHAOS OFF"}</button>
            </div>
            {chaosMode && <SliderRow label="RATE" value={chaosSpeed} min={40} max={600} step={10} onChange={setChaosSpeed}/>}
            {chaosMode && <div style={{ fontSize: 9, color: "rgba(255,68,102,0.5)", letterSpacing: "1px", marginTop: 4 }}>lower = faster chaos</div>}

            {/* ── RESET */}
            <SectionLabel>RESET</SectionLabel>
            <button
              onClick={() => {
                setBrightness(1); setContrast(1); setSaturation(1);
                setHueShift(0); setZoom(0); setScanlines(0); setSpeed(1); setGain(0.5);
                setSortAmt(0); setScanTear(0); setRGBDrift(0); setBlockGlitch(0); setDatamosh(0); setChrash(0);
                setLiquid(0); setTimeSmear(0); setFeedback(0); setContour(0); setAscii(0); setVenetian(0);
                setChaosMode(false); setChaosSpeed(120);
              }}
              style={{ ...modeBtnStyle, fontSize: 10, letterSpacing: "1px", width: "100%" }}
            >↺ RESET ALL</button>

          </div>
        </div>
      </div>

      <style>{`
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
      `}</style>
    </div>
  );
}

// ── Shared styles ────────────────────────────────────────────
const topBtnStyle: React.CSSProperties = {
  background: "linear-gradient(180deg, #222238, #181828, #222238)",
  border: "2px solid #333350",
  borderRadius: 6,
  color: "rgba(255,255,255,0.75)",
  width: 38, height: 38,
  fontSize: 16,
  cursor: "pointer",
  display: "flex", alignItems: "center", justifyContent: "center",
  fontFamily: "inherit",
};

const modeBtnStyle: React.CSSProperties = {
  background: "linear-gradient(180deg, #1e1e32, #141426, #1e1e32)",
  border: "2px solid #2a2a44",
  borderRadius: 6,
  color: "rgba(255,255,255,0.5)",
  padding: "8px 10px",
  fontFamily: "'Courier New', monospace",
  fontSize: 11,
  letterSpacing: "2px",
  textTransform: "uppercase",
  cursor: "pointer",
  minWidth: 44, minHeight: 40,
};

const modeBtnActive: React.CSSProperties = {
  background: "linear-gradient(180deg, #0a1a2a, #0d2030, #0a1a2a)",
  borderColor: "rgba(0,229,255,0.6)",
  color: "#00E5FF",
  boxShadow: "0 0 10px rgba(0,229,255,0.2)",
  textShadow: "0 0 6px rgba(0,229,255,0.5)",
};

// ── Section label helper ─────────────────────────────────────
function SectionLabel({ children }: { children: React.ReactNode }) {
  return (
    <div style={{ fontSize: 9, letterSpacing: "3px", color: "rgba(0,229,255,0.4)", marginBottom: 6, marginTop: 12, textTransform: "uppercase" }}>
      {children}
    </div>
  );
}

// ── Slider helper ────────────────────────────────────────────
function SliderRow({
  label, value, min, max, step, onChange, compact,
}: {
  label: string; value: number; min: number; max: number; step: number;
  onChange: (v: number) => void; compact?: boolean;
}) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: compact ? 6 : 10 }}>
      <span style={{ fontSize: 10, letterSpacing: "2px", color: "rgba(0,229,255,0.45)", minWidth: compact ? 24 : 40 }}>{label}</span>
      <input
        type="range" min={min} max={max} step={step} value={value}
        onChange={e => onChange(Number(e.target.value))}
        style={{ flex: 1, accentColor: "#00E5FF", height: 4, cursor: "pointer" }}
      />
    </div>
  );
}
