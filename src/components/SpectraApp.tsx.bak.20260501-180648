    if (!gifInterval.current) return;
    clearInterval(gifInterval.current);
    gifInterval.current = null;
    setRecording(false);
    const frames = gifFrames.current.slice();
    gifFrames.current = [];
    if (frames.length < 2) return;
    setTimeout(() => {
      const canvas = canvasRef.current!;
      const scale = Math.min(1, 640 / canvas.width);
      const gw = Math.round(canvas.width * scale), gh = Math.round(canvas.height * scale);
      const data = encodeGIF(gw, gh, frames, Math.round(100 / GIF_FPS));
      const blob = new Blob([data as unknown as BlobPart], { type: "image/gif" });
      const filename = `spectra-${MODES[mode].short.toLowerCase()}-${Date.now()}.gif`;
      // Native: write to cache then share to Photos / Files
      const reader = new FileReader();
      reader.onload = async () => {
        const b64 = (reader.result as string).split(",")[1];
        try {
          const { Filesystem, Directory } = await capFilesystem();
          const { uri } = await Filesystem.writeFile({ path: filename, data: b64, directory: Directory.Cache });
          const Share = await capShare();
          await Share.share({ title: "SPECTRA GIF", url: uri, dialogTitle: "Save GIF" });
        } catch {
          // Fallback for desktop / browser preview
