          boxShadow:"0 0 12px 4px rgba(0,229,255,.85)", transition:"left .12s linear",
        }}/>
      </div>

      {/* Status label */}
      <div style={{
        fontFamily:"'Courier New',monospace", fontSize:10, letterSpacing:"4px",
        color:"rgba(0,229,255,.4)", animation:"bootPulse 1.5s ease infinite",
      }}>
        {status}
      </div>
    </div>
  );
}



// ── Draw overlay helpers ─────────────────────────────────────
interface DrawPoint { x: number; y: number; pressure: number }
interface DrawStroke { points: DrawPoint[]; color: string; width: number; opacity: number }



// ── WebGL helpers ────────────────────────────────────────────
function compileShader(gl: WebGLRenderingContext, type: number, src: string): WebGLShader | null {
  const s = gl.createShader(type);
  if (!s) return null;
  gl.shaderSource(s, src);
  gl.compileShader(s);
  if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
    console.error("Shader error:", gl.getShaderInfoLog(s));
    gl.deleteShader(s);
    return null;
  }
  return s;
}

