    const srcH = (vid && vid.videoHeight > 0) ? vid.videoHeight : canvas.height;
    const tmp = document.createElement("canvas");
    tmp.width = srcW; tmp.height = srcH;
    const ctx = tmp.getContext("2d")!;
    ctx.drawImage(canvas, 0, 0, srcW, srcH);
