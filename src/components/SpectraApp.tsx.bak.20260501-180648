    return () => clearInterval(id);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [chaosMode, chaosSpeed, bootDone]);

  // ── Combo layer UI ───────────────────────────────────────
  const toggleComboLayer = (m: ModeId) => {
    if (!comboMode) {
      setComboLayers([]);
      setMode(m);
      return;
    }
    setComboLayers(prev => {
      const exists = prev.findIndex(l => l.mode === m);
      if (exists >= 0) return prev.filter((_,i) => i !== exists);
      if (prev.length >= 2) return [...prev.slice(1), { mode: m, gain }];
      return [...prev, { mode: m, gain }];
    });
  };

  const activeModes = comboMode && comboLayers.length > 0
    ? new Set(comboLayers.map(l => l.mode))
    : new Set([mode]);



  // ── Render ───────────────────────────────────────────────
  const modeLabel = MODES.find(m => m.id === mode)?.label ?? "";

  return (
    <div className="flex flex-col h-dvh overflow-hidden bg-black text-white" style={{ fontFamily: "'Courier New', monospace" }}>
      <BootScreen progress={bootProgress} done={bootDone} />

      {/* Hidden video */}
      <video ref={videoRef} style={{ display: "none" }} playsInline muted autoPlay/>

      {/* ── Top bar */}
      <div style={{
        height: 48,
        background: "linear-gradient(180deg, #1c1c2e 0%, #0d0d1c 100%)",
        borderBottom: "2px solid #2a2a40",
        display: "grid", gridTemplateColumns: "1fr auto 1fr",
        alignItems: "center", padding: "0 10px",
        flexShrink: 0, zIndex: 20,
      }}>
        {/* Left — minimize app on mobile */}
        <button
          onClick={async () => { try { const App = await capApp(); await App.minimizeApp(); } catch { /* desktop */ } }}
          style={{ background: "none", border: "none", color: "#00E5FF", fontSize: 11, letterSpacing: "3px", opacity: 0.7, cursor: "pointer", justifySelf: "start", padding: 0 }}
        >⊟ HOME</button>
        {/* Center */}
        <SpectraLogo size={18} chromaShift={0}/>
        {/* Right */}
        <div style={{ display: "flex", gap: 4, justifySelf: "end", alignItems: "center" }}>
          <button onClick={captureStill} style={topBtnStyle} title="Save PNG">↗</button>
          <button
            onClick={recording ? stopRecording : startRecording}
            style={{ ...topBtnStyle, color: recording ? "#ff4466" : undefined, borderColor: recording ? "#ff4466" : undefined }}
            title="GIF"
          >⊙</button>
          <button
            onClick={cameraActive ? stopCamera : startCamera}
            style={{ ...topBtnStyle, color: cameraActive ? "#00E5FF" : undefined, borderColor: cameraActive ? "#00E5FF" : undefined }}
            title="Camera"
          >{cameraActive ? "●" : "◎"}</button>
          {cameraActive && <button onClick={flipCamera} style={topBtnStyle} title="Flip">⇌</button>}
          <button
            onClick={() => setAudioActive(a => !a)}
            style={{ ...topBtnStyle, color: audioActive ? "#00E5FF" : undefined, borderColor: audioActive ? "#00E5FF" : undefined }}
            title="Audio-Reactive FX"
          >{audioActive ? "🔊" : "🔈"}</button>
        </div>
      </div>

      {/* ── Body: camera top, settings bottom (mobile); side-by-side (lg) */}
      <div className="flex-1 min-h-0 flex flex-col lg:flex-row overflow-hidden">

        {/* Camera viewport — top half on mobile, left pane on desktop */}
        <div className="flex-none h-[45dvh] lg:h-auto lg:flex-1 relative bg-black overflow-hidden flex items-center justify-center">
